{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-finance",
  "version": "1.2.8",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bilalbayram/opencode-finance"
  },
  "files": [
    "skill",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
