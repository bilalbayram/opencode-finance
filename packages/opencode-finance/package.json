  },
  "dependencies": {
    "fast-xml-parser": "5.3.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.9",
    "@types/node": "22.13.9",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "typescript": "5.8.2"
  },
  "description": "Finance data skill for coding agents: SEC EDGAR filings, XBRL fundamentals, insider trades and prices from primary sources.",
  "bin": {
    "fin": "./skill/scripts/fin.mjs"
  }
