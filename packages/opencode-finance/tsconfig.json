{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "module": "preserve",
    "declaration": false,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "node"
    ],
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src",
    "test"
  ]
}
